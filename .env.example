# Demain environment variables
#
# Copy this file to .env and adjust the values. The application validates its
# environment at startup and refuses to start if a required variable is missing
# or invalid. Each new variable is added here, with a placeholder value and a
# comment, in the same change that introduces it.
#
# Never put a real secret in this file.

# Required. Directory that holds the SQLite database file (demain.db). Created
# if it does not exist. In Docker, point it to the mounted volume (for example
# /data). It holds personal financial data: keep it out of version control.
DEMAIN_DATA_DIR=./data

# Optional. IANA time zone used for "today" (default date of the forms, current
# month of the synthesis). Defaults to the time zone of the server, which is
# usually UTC in Docker.
# TZ=Europe/Paris
