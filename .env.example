# Demain environment variables
#
# Copy this file to .env and adjust the values. The application validates its
# environment at startup and refuses to start if a required variable is missing
# or invalid. Each new variable is added here, with a placeholder value and a
# comment, in the same change that introduces it.
#
# Never put a real secret in this file.

# Required. Directory that holds the SQLite database file (demain.db). Created
# if it does not exist. With the provided compose.yaml the value is forced to
# /data, the mounted volume, and this line has no effect. It holds personal
# financial data: keep it out of version control.
DEMAIN_DATA_DIR=./data

# Required until the account exists, then unused. One-time token that protects the
# setup page: anyone reaching a fresh instance needs it to create the single
# account, so nobody can take it over before you. At least 32 characters, for
# example the output of `openssl rand -base64 32`. Left empty, the setup page
# stays closed (never copy a token from documentation: it would be known to
# everyone). Remove it once the account is created.
DEMAIN_SETUP_TOKEN=

# Optional. IANA time zone used for "today" (default date of the forms, current
# month of the synthesis). Defaults to the time zone of the server, which is
# usually UTC in Docker.
# TZ=Europe/Paris
