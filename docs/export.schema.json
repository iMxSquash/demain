{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "demain-export"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "ISO 8601 instant, UTC."
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "checking",
              "savings",
              "other"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217 currency code."
          },
          "openingDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Calendar date, YYYY-MM-DD, without time or timezone."
          },
          "openingBalance": {
            "type": "object",
            "properties": {
              "minorUnits": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Signed integer in the minor unit of the currency (cents for EUR). Never a decimal."
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "ISO 4217 currency code."
              }
            },
            "required": [
              "minorUnits",
              "currency"
            ],
            "additionalProperties": false,
            "description": "An amount with its currency."
          },
          "archived": {
            "type": "boolean"
          },
          "depositCeiling": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "minorUnits": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991,
                    "description": "Signed integer in the minor unit of the currency (cents for EUR). Never a decimal."
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$",
                    "description": "ISO 4217 currency code."
                  }
                },
                "required": [
                  "minorUnits",
                  "currency"
                ],
                "additionalProperties": false,
                "description": "An amount with its currency."
              },
              {
                "type": "null"
              }
            ],
            "description": "Null: no ceiling."
          },
          "overflowAccountId": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Account receiving what does not fit under the ceiling."
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "currency",
          "openingDate",
          "openingBalance",
          "archived",
          "depositCeiling",
          "overflowAccountId"
        ],
        "additionalProperties": false
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "archived"
        ],
        "additionalProperties": false
      }
    },
    "categorizationRules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "operator": {
            "type": "string",
            "enum": [
              "contains",
              "starts_with",
              "equals"
            ]
          },
          "value": {
            "type": "string"
          },
          "accountId": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Null: the rule applies to every account."
          },
          "categoryId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "priority": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Lower comes first: the first matching rule wins."
          }
        },
        "required": [
          "id",
          "operator",
          "value",
          "accountId",
          "categoryId",
          "priority"
        ],
        "additionalProperties": false
      }
    },
    "importBatches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "accountId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "ofx"
            ]
          },
          "importedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "ISO 8601 instant, UTC."
          },
          "fileName": {
            "type": "string"
          },
          "mapping": {
            "description": "CSV only: the column mapping, as a JSON text.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "accountId",
          "format",
          "importedAt",
          "fileName",
          "mapping"
        ],
        "additionalProperties": false
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "accountId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Calendar date, YYYY-MM-DD, without time or timezone."
          },
          "amount": {
            "type": "object",
            "properties": {
              "minorUnits": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Signed integer in the minor unit of the currency (cents for EUR). Never a decimal."
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "ISO 4217 currency code."
              }
            },
            "required": [
              "minorUnits",
              "currency"
            ],
            "additionalProperties": false,
            "description": "Negative leaves the account. In the currency of the account."
          },
          "kind": {
            "type": "string",
            "enum": [
              "expense",
              "income",
              "interest",
              "transfer"
            ]
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "paymentMode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "card",
                  "transfer",
                  "direct_debit"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "categoryId": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Null: waiting in the to-categorize queue. A transfer has none."
          },
          "transferCounterpartId": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "The other leg of a transfer."
          },
          "importBatchId": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "accountId",
          "date",
          "amount",
          "kind",
          "label",
          "description",
          "paymentMode",
          "categoryId",
          "transferCounterpartId",
          "importBatchId"
        ],
        "additionalProperties": false
      }
    },
    "balanceAssertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "accountId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Calendar date, YYYY-MM-DD, without time or timezone."
          },
          "amount": {
            "type": "object",
            "properties": {
              "minorUnits": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Signed integer in the minor unit of the currency (cents for EUR). Never a decimal."
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "ISO 4217 currency code."
              }
            },
            "required": [
              "minorUnits",
              "currency"
            ],
            "additionalProperties": false,
            "description": "The real balance observed at the bank, end of day."
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "accountId",
          "date",
          "amount",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "exchangeRates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Calendar date, YYYY-MM-DD, without time or timezone."
          },
          "base": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217 currency code."
          },
          "quote": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217 currency code."
          },
          "rate": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Exact scaled integer: 1 base is worth rate / 100000000 quote."
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "ecb"
            ]
          }
        },
        "required": [
          "id",
          "date",
          "base",
          "quote",
          "rate",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "exportedAt",
    "settings",
    "accounts",
    "categories",
    "categorizationRules",
    "importBatches",
    "transactions",
    "balanceAssertions",
    "exchangeRates"
  ],
  "additionalProperties": false,
  "description": "Everything Demain holds except the credentials of the account (password hash, second factor, sessions)."
}
